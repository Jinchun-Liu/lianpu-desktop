{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lianpu:licensing:proposed-license-v2",
  "$comment": "Specification only. No shipped verifier or issuer accepts or emits this version. Schema validation does not replace signature, device, time, revision or entitlement checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keyId", "payload", "signature"],
  "properties": {
    "keyId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "productId", "licenseId", "deviceId", "devicePublicKeySpki", "plan", "firstActivatedAt", "issuedAt", "expiresAt", "revision", "requestId", "capabilities", "seats"],
      "properties": {
        "v": {"const": 2}, "type": {"const": "license"},
        "productId": {"const": "lianpu-desktop"},
        "licenseId": {"$ref": "#/$defs/uuid"}, "requestId": {"$ref": "#/$defs/uuid"},
        "deviceId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "devicePublicKeySpki": {"type": "string", "pattern": "^[A-Za-z0-9_-]{122}$"},
        "plan": {"enum": ["week", "month", "year", "perpetual"]},
        "firstActivatedAt": {"$ref": "#/$defs/timestamp"}, "issuedAt": {"$ref": "#/$defs/timestamp"},
        "expiresAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$"}},
        "seats": {"type": "object", "additionalProperties": false, "required": ["unit", "count", "binding"], "properties": {"unit": {"const": "device"}, "count": {"const": 1}, "binding": {"const": "single-device"}}}
      },
      "allOf": [{"if": {"properties": {"plan": {"const": "perpetual"}}}, "then": {"properties": {"expiresAt": {"type": "null"}}}, "else": {"properties": {"expiresAt": {"$ref": "#/$defs/timestamp"}}}}]
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"},
    "timestamp": {"type": "integer", "minimum": 1, "maximum": 8640000000000000}
  }
}
